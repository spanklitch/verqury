{
  "name": "verqury-app",
  "version": "0.6.0",
  "private": true,
  "description": "Verqury Electron shell — workflow layer over AI-assisted product development",
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "author": "FlawedWorks <hello@flawedworks.com>",
  "homepage": "https://flawedworks.com",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "node-pty": "^1.1.0",
    "nodemailer": "^9.0.3",
    "verqury-core": "*"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.flawedworks.verqury",
    "productName": "Verqury",
    "electronVersion": "41.7.1",
    "directories": {
      "output": "dist",
      "buildResources": "renderer/assets"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/**/*",
      "src/**/*"
    ],
    "asar": false,
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "renderer/assets/icon.png",
      "maintainer": "FlawedWorks <hello@flawedworks.com>",
      "synopsis": "Layer, not IDE — a workflow companion for AI-assisted product development."
    }
  }
}
