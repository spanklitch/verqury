# Secrets — never committed
.env
*.p8
*.pem
*.key

# Dependencies & build output
node_modules/
dist/
build/
out/

# Rebuildable index / local data (ADR-0001: files are the database, index is cache)
# Glob covers WAL side files (index.sqlite-wal / -shm) too.
*.sqlite*

# Noise
*.log
.DS_Store

# Orchestrator working state — local only (may contain personal IDs)
SESSION_STATE.md

# Internal infra/lab notes — local only (documents DNS/email/registrant details)
docs/website.md
